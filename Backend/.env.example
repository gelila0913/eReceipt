# ====================================================
# eReceipt Backend — Environment Variables
# Copy this file to .env and fill in real values
# ====================================================

# Server
PORT=5000
NODE_ENV=development

# ⚠️  SECURITY: Change JWT_SECRET to a long random string before deploying!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS: comma-separated list of allowed frontend origins
# Examples:
#   Development:   http://localhost:5173
#   Production:    https://app.ereceipt.et,https://www.ereceipt.et
CORS_ORIGIN=http://localhost:5173

# Frontend URL (used in QR code verification links on printed receipts)
FRONTEND_URL=http://localhost:5173

# Tax Settings
TAX_RATE=0.15

# EIMS Fiscal Clearance
EIMS_CLEARANCE_MODE=simulation
EIMS_SECRET_KEY=mor-eims-fiscal-secret-key-2026
MERCHANT_CODE=AM2081
BRANCH_CODE=BOL01
REGISTER_CODE=REG01

# Email (Resend API — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@ereceipt.et

# PostgreSQL (for Docker/production deployment)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ereceipt
# DB_USER=ereceipt_user
# DB_PASSWORD=CHANGE_ME_DB_PASSWORD
